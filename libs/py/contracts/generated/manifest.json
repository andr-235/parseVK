{
  "contracts": [
    {
      "causationPolicy": "optional",
      "consumers": [
        "moderation-service"
      ],
      "correlationRequired": false,
      "messageType": "content.canonical_comments_changed",
      "partitionKey": {
        "paths": [
          "payload.postKey"
        ],
        "separator": ":"
      },
      "producers": [
        "content-service"
      ],
      "topic": "parsevk.content.events"
    },
    {
      "causationPolicy": "optional",
      "consumers": [
        "vk-service"
      ],
      "correlationRequired": false,
      "messageType": "sources.access.granted",
      "partitionKey": {
        "paths": [
          "payload.sourceId"
        ],
        "separator": ":"
      },
      "producers": [
        "tasks-service"
      ],
      "topic": "parsevk.sources.events"
    },
    {
      "causationPolicy": "optional",
      "consumers": [
        "vk-service"
      ],
      "correlationRequired": false,
      "messageType": "sources.access.revoked",
      "partitionKey": {
        "paths": [
          "payload.sourceId"
        ],
        "separator": ":"
      },
      "producers": [
        "tasks-service"
      ],
      "topic": "parsevk.sources.events"
    },
    {
      "causationPolicy": "forbidden",
      "consumers": [
        "vk-service"
      ],
      "correlationPath": "payload.executionId",
      "correlationRequired": true,
      "messageType": "vk.execution.cancel_requested",
      "partitionKey": {
        "paths": [
          "payload.executionId"
        ],
        "separator": ":"
      },
      "producers": [
        "tasks-service"
      ],
      "topic": "parsevk.vk.commands"
    },
    {
      "causationPolicy": "forbidden",
      "consumers": [
        "vk-service"
      ],
      "correlationPath": "payload.executionId",
      "correlationRequired": true,
      "messageType": "vk.execution.requested",
      "partitionKey": {
        "paths": [
          "payload.executionId"
        ],
        "separator": ":"
      },
      "producers": [
        "tasks-service"
      ],
      "topic": "parsevk.vk.commands"
    },
    {
      "causationPolicy": "optional",
      "consumers": [
        "content-service"
      ],
      "correlationRequired": false,
      "messageType": "vk.ingestion.comment-part-prepared",
      "partitionKey": {
        "paths": [
          "payload.source.ownerId",
          "payload.source.postId"
        ],
        "separator": ":"
      },
      "producers": [
        "vk-service"
      ],
      "topic": "parsevk.content.ingestion.vk"
    },
    {
      "causationPolicy": "optional",
      "consumers": [
        "content-service"
      ],
      "correlationRequired": false,
      "messageType": "vk.ingestion.post-part-prepared",
      "partitionKey": {
        "paths": [
          "payload.source.ownerId",
          "payload.source.postId"
        ],
        "separator": ":"
      },
      "producers": [
        "vk-service"
      ],
      "topic": "parsevk.content.ingestion.vk"
    }
  ],
  "package": {
    "name": "parsevk-contracts",
    "repository": "github.com/andr-235/parseVK",
    "version": "0.1.0"
  }
}
