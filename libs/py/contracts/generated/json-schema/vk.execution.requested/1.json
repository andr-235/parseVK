{
  "$defs": {
    "CommentSelection": {
      "additionalProperties": false,
      "description": "Comment collection strategy.",
      "properties": {
        "includeThreadReplies": {
          "const": true,
          "title": "Includethreadreplies",
          "type": "boolean"
        },
        "mode": {
          "const": "all",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "includeThreadReplies"
      ],
      "title": "CommentSelection",
      "type": "object"
    },
    "PostSelection": {
      "additionalProperties": false,
      "description": "Post collection strategy.",
      "properties": {
        "limitPerSource": {
          "maximum": 100,
          "minimum": 1,
          "title": "Limitpersource",
          "type": "integer"
        },
        "strategy": {
          "const": "latestByPublishedAt",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "limitPerSource"
      ],
      "title": "PostSelection",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Reference to a VK community source.",
      "properties": {
        "externalId": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Externalid",
          "type": "string"
        },
        "ownerId": {
          "exclusiveMaximum": 0,
          "title": "Ownerid",
          "type": "integer"
        },
        "provider": {
          "const": "vk",
          "title": "Provider",
          "type": "string"
        },
        "sourceId": {
          "format": "uuid",
          "title": "Sourceid",
          "type": "string"
        },
        "sourceType": {
          "const": "community",
          "title": "Sourcetype",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "provider",
        "sourceType",
        "externalId",
        "ownerId"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "VkExecutionRequested": {
      "additionalProperties": false,
      "description": "Command payload: request VK execution for one or more sources.",
      "properties": {
        "commentSelection": {
          "$ref": "#/$defs/CommentSelection"
        },
        "demands": {
          "items": {
            "$ref": "#/$defs/VkSourceDemandRequest"
          },
          "minItems": 1,
          "title": "Demands",
          "type": "array"
        },
        "executionId": {
          "format": "uuid",
          "title": "Executionid",
          "type": "string"
        },
        "ownerUserId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owneruserid"
        },
        "postSelection": {
          "$ref": "#/$defs/PostSelection"
        },
        "snapshotSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshotsha256",
          "type": "string"
        },
        "sourceSetRevision": {
          "minimum": 0,
          "title": "Sourcesetrevision",
          "type": "integer"
        },
        "taskId": {
          "exclusiveMinimum": 0,
          "title": "Taskid",
          "type": "integer"
        },
        "taskRevision": {
          "minimum": 0,
          "title": "Taskrevision",
          "type": "integer"
        },
        "taskRunId": {
          "format": "uuid",
          "title": "Taskrunid",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "taskRunId",
        "executionId",
        "demands",
        "postSelection",
        "commentSelection",
        "taskRevision",
        "sourceSetRevision",
        "snapshotSha256"
      ],
      "title": "VkExecutionRequested",
      "type": "object"
    },
    "VkSourceDemandRequest": {
      "additionalProperties": false,
      "description": "A single source collection demand within an execution request.",
      "properties": {
        "demandId": {
          "format": "uuid",
          "title": "Demandid",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "demandId",
        "source"
      ],
      "title": "VkSourceDemandRequest",
      "type": "object"
    }
  },
  "$id": "urn:parsevk:contract:vk.execution.requested:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for vk.execution.requested v1",
  "properties": {
    "causationId": {
      "type": "null"
    },
    "correlationId": {
      "format": "uuid",
      "type": "string"
    },
    "messageId": {
      "format": "uuid",
      "title": "Messageid",
      "type": "string"
    },
    "messageType": {
      "const": "vk.execution.requested"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/VkExecutionRequested"
    },
    "producer": {
      "enum": [
        "tasks-service"
      ]
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "messageId",
    "messageType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "payload",
    "correlationId"
  ],
  "title": "vk.execution.requested",
  "type": "object"
}
